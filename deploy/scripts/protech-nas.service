[Unit]
Description=ProTech NAS Backend (FastAPI + Uvicorn)
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=alex_chiang
Group=alex_chiang
WorkingDirectory=/home/alex_chiang/projects/protech-nas/backend
EnvironmentFile=/home/alex_chiang/projects/protech-nas/backend/.env
ExecStart=/home/alex_chiang/projects/protech-nas/backend/.venv/bin/uvicorn src.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=protech-nas

# Security hardening
NoNewPrivileges=false
ProtectSystem=false
PrivateTmp=true

[Install]
WantedBy=multi-user.target
