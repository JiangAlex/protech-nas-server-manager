# ============================================================
# Protech NAS Server Manager - 環境變數設定
# 複製此檔案為 .env 並填入實際值
# ============================================================

# --- 應用程式設定 ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=info

# --- 管理介面認證 ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production
SESSION_SECRET_KEY=change-this-to-a-random-secret-key

# --- PostgreSQL 資料庫 (使用外部已有的 PostgreSQL 15) ---
POSTGRES_DB=nas_manager
POSTGRES_USER=nas_user
POSTGRES_PASSWORD=nas_password
# Docker 容器內連主機的 PG 用 host.docker.internal
# 本機開發直接用 localhost
DATABASE_URL=postgresql+asyncpg://nas_user:nas_password@host.docker.internal:5432/nas_manager

# --- Telegram 通知 ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_NOTIFY_CHAT_ID=your-chat-id-or-group-id

# --- LINE 通知 ---
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_NOTIFY_USER_ID=your-notify-target

# --- Discord 通知 ---
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_NOTIFY_CHANNEL_ID=your-channel-id

# --- NAS 連線預設值 ---
NAS_SSH_DEFAULT_PORT=22
NAS_SSH_DEFAULT_USER=protech
NAS_HEALTH_CHECK_INTERVAL_SECONDS=60

# --- 更新設定 ---
UPDATE_GIT_BRANCH=main
UPDATE_TIMEOUT_SECONDS=300
UPDATE_ROLLBACK_ENABLED=true

# --- Docker (系統控制) ---
DOCKER_SOCKET=/var/run/docker.sock
